{
  "name": "api-financas",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "mysql2": "^3.14.5",
    "jsonwebtoken": "^9.0.2",
    "express-jwt": "^8.4.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test testes/unit",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:shell": "docker compose exec db sh -lc 'mysql -u\"$MYSQL_USER\" -p\"$MYSQL_PASSWORD\" \"$MYSQL_DATABASE\"'"
  }
}